type":"LATENT","link":null,"shape":7},{"name":"latent_8","type":"LATENT","link":null,"shape":7}],"outputs":[{"name":"conditioning","type":"CONDITIONING","links":[25]}],"properties":{"Node name for S&R":"Flux2MultiReferenceLatent"},"widgets_values":["replace","model_default",false]},{"id":32,"type":"MarkdownNote","pos":[1440,540],"size":[600,310],"flags":{},"order":0,"mode":0,"inputs":[],"outputs":[],"title":"How Multi Reference Latent works","properties":{},"widgets_values":["# FLUX.2 Multi Reference Latent\n\n**Implementation role:** adds one to eight FLUX.2 VAE-encoded latent tensors to the positive conditioning metadata. Each batch item is split into an individual reference while preserving input order.\n\n**Place it:** after text conditioning and all reference `VAE Encode` nodes, before the guider or sampler consumes the positive conditioning.\n\n**Main controls**\n- `replace`: discard an existing reference list and use the connected latents.\n- `append`: keep existing references and add the new ones.\n- `model_default`: let the loaded FLUX.2 model select its native placement method.\n- Explicit methods (`index`, `offset`, `uxo/uno`, `index_timestep_zero`) should only be forced when the loader supports them.\n\nThis node does not patch model weights or modify pixels. It prepares the reference-token inputs used by native FLUX.2 attention and by the Identity Feature Transfer node."],"color":"#222","bgcolor":"#000"},{"id":31,"type":"Flux2IdentityFeatureTransfer","pos":[1080,960],"size":[450,450],"flags":{},"order":13,"mode":0,"inputs":[{"name":"model","type":"MODEL","link":20},{"name":"sigmas","type":"SIGMAS","link":21,"shape":7},{"name":"subject_mask_1","type":"MASK","link":22,"shape":7},{"name":"subject_mask_2","type":"MASK","link":23,"shape":7},{"name":"subject_mask_3","type":"MASK","link":null,"shape":7},{"name":"subject_mask_4","type":"MASK","link":null,"shape":7},{"name":"subject_mask_5","type":"MASK","link":null,"shape":7},{"name":"subject_mask_6","type":"MASK","link":null,"shape":7},{"name":"subject_mask_7","type":"MASK","link":null,"shape":7},{"name":"subject_mask_8","type":"MASK","link":null,"shape":7}],"outputs":[{"name":"MODEL","type":"MODEL","links":[24]}],"properties":{"Node name for S&R":"Flux2IdentityFeatureTransfer"},"widgets_values":["AUTO_BALANCED",true,0,"all","normalized_total",0.62,0.2,0.07,0.95,"0-7:mid_img=0.30","0:mid_img=0.20",0.2,1.0,"equal_energy","zero_unmasked_tokens",128,false]},{"id":33,"type":"MarkdownNote","pos":[1590,930],"size":[620,430],"flags":{},"order":0,"mode":0,"inputs":[],"outputs":[],"title":"How masked multi-reference transfer works","properties":{},"widgets_values":["# FLUX.2 Identity Feature Transfer\n\n**Implementation role:** clones the incoming model and installs an attention-output patch. During active denoising steps, generated image tokens are matched against selected reference tokens with centered cosine similarity, temperature-controlled pooling, confidence gating, and optional masks.\n\n**Place it:** after the diffusion model loader and LoRAs, before the guider/sampler. Reference latents must also reach the positive conditioning through `FLUX.2 Multi Reference Latent`.\n\n**Important controls**\n- `AUTO_*` presets derive block schedules from the detected FLUX.2 architecture.\n- `normalized_total` distributes aggregate strength across active blocks.\n- `start_percent` / `end_percent` define the denoising window.\n- Connecting the real `SIGMAS` schedule enables precise progress and equal-energy scaling.\n- `subject_mask_1` maps to `latent_1`, and so on.\n- Lower `query_chunk_size` reduces similarity-matrix VRAM usage.\n\nThe node transfers internal features, not pixels. Strong early transfer may also copy pose, framing, lighting, or background.\n\n\n**This example:** reference 1 supplies identity; reference 2 supplies outfit features. `zero_unmasked_tokens` also blocks masked-out regions from native reference attention."],"color":"#222","bgcolor":"#000"},{"id":8,"type":"RandomNoise","pos":[2300,100],"size":[270,82],"flags":{},"order":10,"mode":0,"inputs":[],"outputs":[{"name":"NOISE","type":"NOISE","links":[3]}],"properties":{"Node name for S&R":"RandomNoise"},"widgets_values":[123456789,"fixed"]},{"id":9,"type":"KSamplerSelect","pos":[2300,220],"size":[270,58],"flags":{},"order":11,"mode":0,"inputs":[],"outputs":[{"name":"SAMPLER","type":"SAMPLER","links":[5]}],"properties":{"Node name for S&R":"KSamplerSelect"},"widgets_values":["euler"]},{"id":10,"type":"CFGGuider","pos":[2300,340],"size":[270,98],"flags":{},"order":12,"mode":0,"inputs":[{"name":"model","type":"MODEL","link":24},{"name":"positive","type":"CONDITIONING","link":25},{"name":"negative","type":"CONDITIONING","link":26}],"outputs":[{"name":"GUIDER","type":"GUIDER","links":[4]}],"properties":{"Node name for S&R":"CFGGuider"},"widgets_values":[]},{"id":6,"type":"EmptyFlux2LatentImage","pos":[2300,510],"size":[270,106],"flags":{},"order":8,"mode":0,"inputs":[],"outputs":[{"name":"LATENT","type":"LATENT","links":[7]}],"properties":{"Node name for S&R":"EmptyFlux2LatentImage"},"widgets_values":[1024,1024,1]},{"id":7,"type":"Flux2Scheduler","pos":[2300,670],"size":[270,106],"flags":{},"order":9,"mode":0,"inputs":[],"outputs":[{"name":"SIGMAS","type":"SIGMAS","links":[6,21]}],"properties":{"Node name for S&R":"Flux2Scheduler"},"widgets_values":[30,1024,1024]},{"id":11,"type":"SamplerCustomAdvanced","pos":[2650,280],"size":[400,300],"flags":{},"order":13,"mode":0,"inputs":[{"name":"noise","type":"NOISE","link":3},{"name":"guider","type":"GUIDER","link":4},{"name":"sampler","type":"SAMPLER","link":5},{"name":"sigmas","type":"SIGMAS","link":6},{"name":"latent_image","type":"LATENT","link":7}],"outputs":[{"name":"output","type":"LATENT","links":[8]},{"name":"denoised_output","type":"LATENT","links":null}],"properties":{"Node name for S&R":"SamplerCustomAdvanced"},"widgets_values":[]},{"id":12,"type":"VAEDecode","pos":[3120,330],"size":[220,46],"flags":{},"order":14,"mode":0,"input