{"id":"796d4ecb-93f7-42ee-9c32-347022a00f02","revision":1,"last_node_id":26,"last_link_id":21,"nodes":[{"id":1,"type":"UNETLoader","pos":[80,100],"size":[340,82],"flags":{},"order":0,"mode":0,"inputs":[],"outputs":[{"name":"MODEL","type":"MODEL","links":[16]}],"properties":{"Node name for S&R":"UNETLoader"},"widgets_values":["flux-2-klein-9b.safetensors","default"]},{"id":2,"type":"CLIPLoader","pos":[80,230],"size":[340,106],"flags":{},"order":1,"mode":0,"inputs":[],"outputs":[{"name":"CLIP","type":"CLIP","links":[1]}],"properties":{"Node name for S&R":"CLIPLoader"},"widgets_values":["qwen_3_8b_fp8mixed.safetensors","flux2","default"]},{"id":3,"type":"VAELoader","pos":[80,380],"size":[340,58],"flags":{},"order":2,"mode":0,"inputs":[],"outputs":[{"name":"VAE","type":"VAE","links":[9,13]}],"properties":{"Node name for S&R":"VAELoader"},"widgets_values":["flux2-vae.safetensors"]},{"id":4,"type":"CLIPTextEncode","pos":[500,120],"size":[430,240],"flags":{},"order":3,"mode":0,"inputs":[{"name":"clip","type":"CLIP","link":1}],"outputs":[{"name":"CONDITIONING","type":"CONDITIONING","links":[2,14]}],"properties":{"Node name for S&R":"CLIPTextEncode"},"widgets_values":["A cinematic portrait of the same adult woman, natural skin texture, editorial lighting, high detail."]},{"id":5,"type":"ConditioningZeroOut","pos":[970,120],"size":[220,46],"flags":{},"order":4,"mode":0,"inputs":[{"name":"conditioning","type":"CONDITIONING","link":2}],"outputs":[{"name":"CONDITIONING","type":"CONDITIONING","links":[21]}],"properties":{"Node name for S&R":"ConditioningZeroOut"},"widgets_values":[]},{"id":20,"type":"LoadImage","pos":[80,620],"size":[300,320],"flags":{},"order":5,"mode":0,"inputs":[],"outputs":[{"name":"IMAGE","type":"IMAGE","links":[11]},{"name":"MASK","type":"MASK","links":[18]}],"properties":{"Node name for S&R":"LoadImage"},"widgets_values":["reference_identity.png","image"]},{"id":21,"type":"ImageScaleToTotalPixels","pos":[440,700],"size":[270,106],"flags":{},"order":6,"mode":0,"inputs":[{"name":"image","type":"IMAGE","link":11}],"outputs":[{"name":"IMAGE","type":"IMAGE","links":[12]}],"properties":{"Node name for S&R":"ImageScaleToTotalPixels"},"widgets_values":["lanczos",1.0,1]},{"id":22,"type":"VAEEncode","pos":[770,730],"size":[190,46],"flags":{},"order":7,"mode":0,"inputs":[{"name":"pixels","type":"IMAGE","link":12},{"name":"vae","type":"VAE","link":13}],"outputs":[{"name":"LATENT","type":"LATENT","links":[15]}],"properties":{"Node name for S&R":"VAEEncode"},"widgets_values":[]},{"id":23,"type":"Flux2MultiReferenceLatent","pos":[1080,520],"size":[290,250],"flags":{},"order":8,"mode":0,"inputs":[{"name":"conditioning","type":"CONDITIONING","link":14},{"name":"latent_1","type":"LATENT","link":15},{"name":"latent_2","type":"LATENT","link":null,"shape":7},{"name":"latent_3","type":"LATENT","link":null,"shape":7},{"name":"latent_4","type":"LATENT","link":null,"shape":7},{"name":"latent_5","type":"LATENT","link":null,"shape":7},{"name":"latent_6","type":"LATENT","link":null,"shape":7},{"name":"latent_7","type":"LATENT","link":null,"shape":7},{"name":"latent_8","type":"LATENT","link":null,"shape":7}],"outputs":[{"name":"conditioning","type":"CONDITIONING","links":[20]}],"properties":{"Node name for S&R":"Flux2MultiReferenceLatent"},"widgets_values":["replace","model_default",false]},{"id":25,"type":"MarkdownNote","pos":[1430,500],"size":[560,300],"flags":{},"order":0,"mode":0,"inputs":[],"outputs":[],"title":"How Multi Reference Latent works","properties":{},"widgets_values":["# FLUX.2 Multi Reference Latent\n\n**Implementation role:** adds one to eight FLUX.2 VAE-encoded latent tensors to the positive conditioning metadata. Each batch item is split into an individual reference while preserving input order.\n\n**Place it:** after text conditioning and all reference `VAE Encode` nodes, before the guider or sampler consumes the positive conditioning.\n\n**Main controls**\n- `replace`: discard an existing reference list and use the connected latents.\n- `append`: keep existing references and add the new ones.\n- `model_default`: let the loaded FLUX.2 model select its native placement method.\n- Explicit methods (`index`, `offset`, `uxo/uno`, `index_timestep_zero`) should only be forced when the loader supports them.\n\nThis node does not patch model weights or modify pixels. It prepares the reference-token inputs used by native FLUX.2 attention and by the Identity Feature Transfer node."],"color":"#222","bgcolor":"#000"},{"id":24,"type":"Flux2IdentityFeatureTransfer","pos":[1080,850],"size":[440,440],"flags":{},"order":9,"mode":0,"inputs":[{"name":"model","type":"MODEL","link":16},{"name":"sigmas","type":"SIGMAS","link":17,"shape":7},{"name":"subject_mask_1","type":"MASK","link":18,"shape":7},{"name":"subject_mask_2","type":"MASK","link":null,"shape":7},{"name":"subject_mask_3","type":"MASK","link":null,"shape":7},{"name":"subject_mask_4","type":"MASK","link":null,"shape":7},{"name":"subject_mask_5","type":"MASK","link":null,"shape":7},{"name":"subject_mask_6","type":"MASK","link":null,"shape":7},{"name":"subject_mask_7","type":"MASK","link":null,"shape":7},{"name":"subject_mask_8","type":"MASK","link":null,"shape":7}],"outputs":[{"name":"MODEL","type":"MODEL","links":[19]}],"properties":{"Node name for S&R":"Flux2IdentityFeatureTransfer"},"widgets_values":["AUTO_BALANCED",true,0,"all","normalized_total",0.55,0.2,0.07,0.95,"0-7:mid_img=0.30","0:mid_img=0.20",0.0,1.0,"equal_energy","focus_only",256,false]},{"id":26,"type":"MarkdownNote","pos":[1580,850],"size":[610,410],"flags":{},"order":0,"mode":0,"inputs":[],"outputs":[],"title":"How Identity Feature Transfer works","properties":{},"widgets_values":["# FLUX.2 Identity Feature Transfer\n\n**Implementation role:** clones the incoming model and installs an attention-output patch. During active denoising steps, generated image tokens are matched against selected reference tokens with centered cosine similarity, temperature-controlled pooling, confidence gating, and optional masks.\n\n**Place it:** after the diffusion model loader and LoRAs, before the guider/sampler. Reference latents must also reach the positive conditioning through `FLUX.2 Multi Reference Latent`.\n\n**Important controls**\n- `AUTO_*` presets derive block schedules from the detected FLUX.2 architecture.\n- `normalized_total` distributes aggregate strength across active blocks.\n- `start_percent` / `end_percent` define the denoising window.\n- Connecting the real `SIGMAS` schedule enables precise progress and equal-energy scaling.\n- `subject_mask_1` maps to `latent_1`, and so on.\n- Lower `query_chunk_size` reduces similarity-matrix VRAM usage.\n\nThe node transfers internal features, not pixels. Strong early transfer may also copy pose, framing, lighting, or background."],"color":"#222","bgcolor":"#000"},{"id":8,"type":"RandomNoise","pos":[2250,100],"size":[270,82],"flags":{},"order":10,"mode":0,"inputs":[],"outputs":[{"name":"NOISE","type":"NOISE","links":[3]}],"properties":{"Node name for S&R":"RandomNoise"},"widgets_values":[123456789,"fixed"]},{"id":9,"type":"KSamplerSelect","pos":[2250,220],"size":[270,58],"flags":{},"order":11,"mode":0,"inputs":[],"outputs":[{"name":"SAMPLER","type":"SAMPLER","links":[5]}],"properties":{"Node name for S&R":"KSamplerSelect"},"widgets_values":["euler"]},{"id":10,"type":"CFGGuider","pos":[2250,340],"size":[270,98],"flags":{},"order":12,"mode":0,"inputs":[{"name":"model","type":"MODEL","link":19},{"name":"positive","type":"CONDITIONING","link":20},{"name":"negative","type":"CONDITIONING","link":21}],"outputs":[{"name":"GUIDER","type":"GUIDER","links":[4]}],"properties":{"Node name for S&R":"CFGGuider"},"widgets_values":[]},{"id":6,"type":"EmptyFlux2LatentImage","pos":[2250,510],"size":[270,106],"flags":{},"order":8,"mode":0,"inputs":[],"outputs":[{"name":"LATENT","type":"LATENT","links":[7]}],"properties":{"Node name for S&R":"EmptyFlux2LatentImage"},"widgets_values":[1024,1024,1]},{"id":7,"type":"Flux2Scheduler","pos":[2250,670],"size":[270,106],"flags":{},"order":9,"mode":0,"inputs":[],"outputs":[{"name":"SIGMAS","type":"SIGMAS","links":[6,17]}],"properties":{"Node name for S&R":"Flux2Scheduler"},"widgets_values":[4,1024,1024]},{"id":11,"type":"SamplerCustomAdvanced","pos":[2600,280],"size":[400,300],"flags":{},"order":13,"mode":0,"inputs":[{"name":"noise","type":"NOISE","link":3},{"name":"guider","type":"GUIDER","link":4},{"name":"sampler","type":"SAMPLER","link":5},{"name":"sigmas","type":"SIGMAS","link":6},{"name":"latent_image","type":"LATENT","link":7}],"outputs":[{"name":"output","type":"LATENT","links":[8]},{"name":"denoised_output","type":"LATENT","links":null}],"properties":{"Node name for S&R":"SamplerCustomAdvanced"},"widgets_values":[]},{"id":12,"type":"VAEDecode","pos":[3070,330],"size":[220,46],"flags":{},"order":14,"mode":0,"inputs":[{"name":"samples","type":"LATENT","link":8},{"name":"vae","type":"VAE","link":9}],"outputs":[{"name":"IMAGE","type":"IMAGE","links":[10]}],"properties":{"Node name for S&R":"VAEDecode"},"widgets_values":[]},{"id":13,"type":"SaveImage","pos":[3360,300],"size":[300,100],"flags":{},"order":15,"mode":0,"inputs":[{"name":"images","type":"IMAGE","link":10}],"outputs":[],"properties":{"Node name for S&R":"SaveImage"},"widgets_values":["FLUX2_Enhancer"]}],"links":[[1,2,0,4,0,"CLIP"],[2,4,0,5,0,"CONDITIONING"],[3,8,0,11,0,"NOISE"],[4,10,0,11,1,"GUIDER"],[5,9,0,11,2,"SAMPLER"],[6,7,0,11,3,"SIGMAS"],[7,6,0,11,4,"LATENT"],[8,11,0,12,0,"LATENT"],[9,3,0,12,1,"VAE"],[10,12,0,13,0,"IMAGE"],[11,20,0,21,0,"IMAGE"],[12,21,0,22,0,"IMAGE"],[13,3,0,22,1,"VAE"],[14,4,0,23,0,"CONDITIONING"],[15,22,0,23,1,"LATENT"],[16,1,0,24,0,"MODEL"],[17,7,0,24,1,"SIGMAS"],[18,20,1,24,2,"MASK"],[19,24,0,10,0,"MODEL"],[20,23,0,10,1,"CONDITIONING"],[21,5,0,10,2,"CONDITIONING"]],"groups":[{"id":1,"title":"1 — Model and prompt","bounding":[40,50,1180,410],"color":"#3f789e","font_size":24,"flags":{}},{"id":2,"title":"2 — Reference preparation","bounding":[40,560,950,